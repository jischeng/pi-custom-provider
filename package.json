{
  "name": "@d4rw1nz/pi-custom-provider",
  "version": "1.0.8",
  "type": "module",
  "description": "Manage Pi providers and models through native TUI, programmatic RPC, and confirmed agent tools",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "llm",
    "provider",
    "models",
    "coding-agent",
    "provider-setup",
    "openai-compatible",
    "oauth"
  ],
  "license": "MIT",
  "author": "d4rw1nz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d4rw1nz/pi-custom-provider.git"
  },
  "bugs": {
    "url": "https://github.com/d4rw1nz/pi-custom-provider/issues"
  },
  "homepage": "https://github.com/d4rw1nz/pi-custom-provider#readme",
  "files": [
    "src",
    "bin",
    "docs",
    "assets/cover.png"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc",
    "rpc": "node bin/pi-extension-rpc.mjs -e ./src/index.ts",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/d4rw1nz/pi-custom-provider/main/assets/cover.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "1.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "24.12.4",
    "@types/proper-lockfile": "4.1.4",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "bin": {
    "pi-extension-rpc": "bin/pi-extension-rpc.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./operations": "./src/operations/index.ts"
  }
}
